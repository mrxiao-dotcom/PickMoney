<Window x:Class="PickMoney.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PickMoney - Binance Futures Scanner"
        Height="900"
        Width="1520"
        MinHeight="760"
        MinWidth="1280"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1.2*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="启动扫描" Command="{Binding StartCommand}" MinWidth="0" />
                    <Button Content="停止扫描" Command="{Binding StopCommand}" Background="{StaticResource DangerBrush}" MinWidth="0" />
                    <Button Content="保存配置" Command="{Binding SaveConfigCommand}" MinWidth="0" />
                    <Button Content="账户设置" Command="{Binding OpenAccountSettingsCommand}" MinWidth="0" />
                    <Button Content="策略设置" Command="{Binding OpenStrategySettingsCommand}" MinWidth="0" />
                    <Button Content="刷新持仓" Command="{Binding RefreshPositionsCommand}" Background="{StaticResource SuccessBrush}" MinWidth="0" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="多账户币安合约 Ticker 扫描系统" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PanelBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="策略 / 推送" />

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding StrategySummary}" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding WebhookSummary}" />

                <TextBox Grid.Column="3"
                         Margin="0,0,12,0"
                         Text="{Binding ManualSymbolsInput, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Content="导入" Command="{Binding ImportManualSymbolsCommand}" Background="{StaticResource SuccessBrush}" MinWidth="0" />
                    <Button Content="策略设置" Command="{Binding OpenStrategySettingsCommand}" MinWidth="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="账户列表" />
                        <TextBlock DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="账户设置可编辑" />
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="0.8*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Text="账户" />
                        <TextBlock Grid.Column="1" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Text="权益(U)" />
                        <TextBlock Grid.Column="2" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Text="净值" />
                        <TextBlock Grid.Column="3" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Text="分摊" />
                        <TextBlock Grid.Column="4" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Text="单币(U)" />
                    </Grid>
                    <ListBox Grid.Row="2"
                             Margin="0,4,0,0"
                             ItemContainerStyle="{StaticResource FlatListBoxItemStyle}"
                             ItemsSource="{Binding Accounts}"
                             SelectedItem="{Binding SelectedAccount, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="0.8*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding DisplayName}" />
                                    <TextBlock Grid.Column="1"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Text="{Binding EquityText}" />
                                    <Button Grid.Column="2"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           MinWidth="0"
                                           FontWeight="SemiBold"
                                           Cursor="Hand"
                                           Command="{Binding ShowNetValueCommand}"
                                           Content="{Binding NetValueText}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="Padding" Value="4,1" />
                                                <Setter Property="Foreground" Value="#16A34A" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNetValueLoss}" Value="True">
                                                        <Setter Property="Foreground" Value="#16A34A" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsNetValueProfit}" Value="True">
                                                        <Setter Property="Foreground" Value="#DC2626" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Grid.Column="3"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Text="{Binding AllocationParts}" />
                                    <TextBlock Grid.Column="4"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Text="{Binding UnitAmount, StringFormat={}{0:F2}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="账户持仓明细" />
                        <TextBlock DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding SelectedAccount.AccountName, TargetNullValue=请选择账户}" />
                    </DockPanel>
                    <TextBlock Grid.Row="1"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="账户权益: " />
                        <Run Text="{Binding SelectedAccountEquity, StringFormat={}{0:G} USDT}" />
                        <Run Text="  |  钱包余额: " />
                        <Run Text="{Binding SelectedAccountWalletBalance, StringFormat={}{0:G} USDT}" />
                        <Run Text="  |  未实现盈亏: " />
                        <Run Text="{Binding SelectedAccountUnrealizedProfit, StringFormat={}{0:G} USDT}" />
                        <Run Text="  |  可用余额: " />
                        <Run Text="{Binding SelectedAccountAvailableBalance, StringFormat={}{0:G} USDT}" />
                        <Run Text="  |  持仓市值: " />
                        <Run Text="{Binding SelectedAccountPositionMarketValue, StringFormat={}{0:G} USDT}" />
                        <Run Text="  |  持仓数: " />
                        <Run Text="{Binding SelectedAccountPositionSymbolCount}" />
                    </TextBlock>
                    <DataGrid Grid.Row="2" Margin="0,10,0,0" ItemsSource="{Binding Positions}" IsReadOnly="True" SelectedItem="{Binding SelectedPosition, Mode=TwoWay}">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="平仓" Command="{Binding ClosePositionCommand}" />
                                <MenuItem Header="一键清仓" Command="{Binding CloseAllPositionsCommand}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="品种" Binding="{Binding Symbol}" Width="90" />
                            <DataGridTextColumn Header="浮盈" Binding="{Binding UnrealizedPnl, StringFormat=F2}" Width="80" />
                            <DataGridTextColumn Header="收益率%" Binding="{Binding PnlPercent, StringFormat=F2}" Width="80" />
                            <DataGridTextColumn Header="市值" Binding="{Binding MarketValue, StringFormat=G}" Width="90" />
                            <DataGridTextColumn Header="数量" Binding="{Binding Quantity, StringFormat=G}" Width="86" />
                            <DataGridTextColumn Header="开仓价" Binding="{Binding EntryPriceText}" Width="104" />
                            <DataGridTextColumn Header="标记价" Binding="{Binding MarkPriceText}" Width="104" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65*" />
                <ColumnDefinition Width="35*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="日志信息" />
                        <TextBlock DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="运行输出" />
                    </DockPanel>
                    <TextBox Grid.Row="1"
                             Margin="0,10,0,0"
                             Padding="12"
                             IsReadOnly="True"
                             Text="{Binding LogText}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             AcceptsReturn="True"
                             Background="{StaticResource SurfaceAltBrush}"
                             BorderBrush="{StaticResource BorderBrushTheme}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Text="本轮跌幅前10" />
                        <TextBlock DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="市场状态" />
                    </DockPanel>
                    <DataGrid Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding TopDropTickers}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="品种" Binding="{Binding Symbol}" Width="90" />
                            <DataGridTextColumn Header="跌幅(%)" Binding="{Binding DropPercent, StringFormat=F2}" Width="72" />
                            <DataGridTextColumn Header="距阈值(%)" Binding="{Binding ThresholdGap, StringFormat=F2}" Width="82" />
                            <DataGridTextColumn Header="现价" Binding="{Binding LastPriceText}" Width="*" />
                            <DataGridTextColumn Header="开盘价" Binding="{Binding OpenPriceText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
